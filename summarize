#!/bin/bash
# venv を activate せずに summarize_video.py を実行するランチャー
DIR="$(cd "$(dirname "$0")" && pwd)"
if [ ! -x "$DIR/.venv/bin/python" ]; then
  echo "エラー: .venv が見つかりません。初回セットアップを実行してください:" >&2
  echo "  python3 -m venv .venv && .venv/bin/pip install -r requirements.txt" >&2
  exit 1
fi
exec "$DIR/.venv/bin/python" "$DIR/summarize_video.py" "$@"
